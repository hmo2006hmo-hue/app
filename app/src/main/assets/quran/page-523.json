{"number":523,"juz":27,"ayahs":[{"number":4727,"text":"كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":52,"juz":27},{"number":4728,"text":"أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌ طَاغُونَ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":53,"juz":27},{"number":4729,"text":"فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":54,"juz":27},{"number":4730,"text":"وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":55,"juz":27},{"number":4731,"text":"وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":56,"juz":27},{"number":4732,"text":"مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍ وَمَآ أُرِيدُ أَن يُطْعِمُونِ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":57,"juz":27},{"number":4733,"text":"إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":58,"juz":27},{"number":4734,"text":"فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًا مِّثْلَ ذَنُوبِ أَصْحَـٰبِهِمْ فَلَا يَسْتَعْجِلُونِ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":59,"juz":27},{"number":4735,"text":"فَوَيْلٌ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ","surah":{"number":51,"name":"الذاريات"},"numberInSurah":60,"juz":27},{"number":4736,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَٱلطُّورِ","surah":{"number":52,"name":"الطور"},"numberInSurah":1,"juz":27},{"number":4737,"text":"وَكِتَـٰبٍ مَّسْطُورٍ","surah":{"number":52,"name":"الطور"},"numberInSurah":2,"juz":27},{"number":4738,"text":"فِى رَقٍّ مَّنشُورٍ","surah":{"number":52,"name":"الطور"},"numberInSurah":3,"juz":27},{"number":4739,"text":"وَٱلْبَيْتِ ٱلْمَعْمُورِ","surah":{"number":52,"name":"الطور"},"numberInSurah":4,"juz":27},{"number":4740,"text":"وَٱلسَّقْفِ ٱلْمَرْفُوعِ","surah":{"number":52,"name":"الطور