{"number":266,"juz":14,"ayahs":[{"number":1873,"text":"قَالَ هَـٰٓؤُلَآءِ بَنَاتِىٓ إِن كُنتُمْ فَـٰعِلِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":71,"juz":14},{"number":1874,"text":"لَعَمْرُكَ إِنَّهُمْ لَفِى سَكْرَتِهِمْ يَعْمَهُونَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":72,"juz":14},{"number":1875,"text":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُشْرِقِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":73,"juz":14},{"number":1876,"text":"فَجَعَلْنَا عَـٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةً مِّن سِجِّيلٍ","surah":{"number":15,"name":"الحجر"},"numberInSurah":74,"juz":14},{"number":1877,"text":"إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّلْمُتَوَسِّمِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":75,"juz":14},{"number":1878,"text":"وَإِنَّهَا لَبِسَبِيلٍ مُّقِيمٍ","surah":{"number":15,"name":"الحجر"},"numberInSurah":76,"juz":14},{"number":1879,"text":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً لِّلْمُؤْمِنِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":77,"juz":14},{"number":1880,"text":"وَإِن كَانَ أَصْحَـٰبُ ٱلْأَيْكَةِ لَظَـٰلِمِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":78,"juz":14},{"number":1881,"text":"فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُّبِينٍ","surah":{"number":15,"name":"الحجر"},"numberInSurah":79,"juz":14},{"number":1882,"text":"وَلَقَدْ كَذَّبَ أَصْحَـٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":80,"juz":14},{"number":1883,"text":"وَءَاتَيْنَـٰهُمْ ءَايَـٰتِنَا فَكَانُوا۟ عَنْهَا مُعْرِضِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":81,"juz":14},{"number":1884,"text":"وَكَانُوا۟ يَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا ءَامِنِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":82,"juz":14},{"number":1885,"text":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُصْبِحِينَ","surah":{"number":15,"name":"الحجر"},"numberInSurah":83,"juz":14},{"number":1886,"text":"فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ","surah":{"number":15,"name":"الحجر"},"numberInS