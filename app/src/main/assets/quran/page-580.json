{"number":580,"juz":29,"ayahs":[{"number":5617,"text":"وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًا طَوِيلًا","surah":{"number":76,"name":"الإنسان"},"numberInSurah":26,"juz":29},{"number":5618,"text":"إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًا ثَقِيلًا","surah":{"number":76,"name":"الإنسان"},"numberInSurah":27,"juz":29},{"number":5619,"text":"نَّحْنُ خَلَقْنَـٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ ۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَـٰلَهُمْ تَبْدِيلًا","surah":{"number":76,"name":"الإنسان"},"numberInSurah":28,"juz":29},{"number":5620,"text":"إِنَّ هَـٰذِهِۦ تَذْكِرَةٌ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا","surah":{"number":76,"name":"الإنسان"},"numberInSurah":29,"juz":29},{"number":5621,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا","surah":{"number":76,"name":"الإنسان"},"numberInSurah":30,"juz":29},{"number":5622,"text":"يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦ ۚ وَٱلظَّـٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا","surah":{"number":76,"name":"الإنسان"},"numberInSurah":31,"juz":29},{"number":5623,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَٱلْمُرْسَلَـٰتِ عُرْفًا","surah":{"number":77,"name":"المرسلات"},"numberInSurah":1,"juz":29},{"number":5624,"text":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا","surah":{"number":77,"name":"المرسلات"},"numberInSurah":2,"juz":29},{"number":5625,"text":"وَٱلنَّـٰشِرَٰتِ نَشْرًا","surah":{"number":77,"name":"المرسلات"},"numberInSurah":3,"juz":29},{"number":5626,"text":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا","surah":{"number":77,"name":"المرسلات"},"numberInSurah":4,"juz":29},{"number":5627,"text":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا","surah":{"number":77,"name":"المرسلات"},"numberInSurah":5,"juz":29},{"number":5628,"text":"عُذْرًا أَوْ نُذْرًا","surah":{"number":77,"name":"المرسلات"},"numberInSurah":6,"juz":29},{"number":5629,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","surah":{"number":77,"name":"المرسلات"},"numberInSurah":7,"juz":29},{"number":5630,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَت