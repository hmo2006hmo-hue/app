<?xml version="1.0" encoding="utf-8"?>
<!-- خط Amiri محلي (bundled font) - amiri_regular.ttf و amiri_bold.ttf مضمّنين بهذا المجلد. -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/amiri_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        app:font="@font/amiri_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
